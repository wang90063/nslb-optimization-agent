# Build output (all compiled binaries go here)
build/

# Stray compiled binaries (legacy: compiled in repo root)
main
main_*
solver
solver*
bin_*
cmp_*
eval_*
hist_*
porthash_*
gate_audit_*
diag_*
dbg_*
debug*
tmp_*
v[0-9]*

# System
.DS_Store
__pycache__/

# Archives
*.zip

# Historical solver versions (kept on disk, not tracked)
versions/archive/*
!versions/archive/.gitkeep

# Local config (track skill definitions + shared settings; ignore machine-local + scratch)
.claude/settings.local.json
.claude/projects/
.claude/skills/*-workspace/
